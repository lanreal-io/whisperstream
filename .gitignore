# Tauri (Rust)
src-tauri/target/
src-tauri/gen/
# Tauri sidecar binaries — fetched by build scripts, not committed.
# whisperstream-engine-*.exe is built by Nuitka (scripts/build.py).
# llama-server-*.exe and *.dll are staged by scripts/fetch_llama_server.py.
src-tauri/binaries/
src-tauri/resources/llama-cpp/

# llama.cpp download cache (populated by scripts/fetch_llama_server.py).
# dist/ is already ignored above; this entry documents the subdirectory path.
dist/cache/llama-cpp/

.playwright-mcp/
.playwright-cli/
.worktrees/

# Pandoc-generated artifacts in legal/ — regenerated from .md sources
legal/**/*.docx
legal/**/*.pdf
.latency_runs/

# Standalone CLI staged by the launchers/builders
src-tauri/bin/
# Exact native dependency inputs restored from the owner archive.
.local-dependencies/

# Exclusive installer profile staging lock; inspect after an interrupted build.
.installer-profile.lock
